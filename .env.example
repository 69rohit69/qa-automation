# Free options (pick one provider)
PROVIDER=gemini

# Google Gemini — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Groq — free key: https://console.groq.com/keys
# PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI — paid (optional)
# PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Same AC → same test cases (recommended: true)
RESPONSE_CACHE=true

# Google Sheets upload (optional)
# GOOGLE_SPREADSHEET_ID=spreadsheet_id_from_url
# GOOGLE_SHEET_TAB=Test Cases
# GOOGLE_CREDENTIALS_PATH=credentials/google-service-account.json
